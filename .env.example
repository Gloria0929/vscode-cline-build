# =============================================================================
# VSCode Server + Cline — Environment Configuration
# =============================================================================
# Copy this file to .env and modify values as needed:
#   cp .env.example .env

# ---- Code-Server Access ----
# Password to access the web IDE (required for browser access)
PASSWORD=changeme

# Sudo password for terminal within code-server (leave empty to disable)
SUDO_PASSWORD=

# ---- User / Group IDs ----
# Match your host user UID/GID for correct file permissions on mounted volumes
# Find your UID: id -u   Find your GID: id -g
PUID=1000
PGID=1000

# ---- Timezone ----
TZ=Asia/Shanghai

# ---- Port ----
# Host port to expose code-server on
PORT=8443

# ---- Domain (optional) ----
# If using a reverse proxy, set the domain here
PROXY_DOMAIN=

# ---- Cline Source (advanced) ----
# Git repository URL for Cline (defaults to official repo)
CLINE_REPO=https://github.com/cline/cline.git
# Branch/tag to build from
CLINE_BRANCH=main
