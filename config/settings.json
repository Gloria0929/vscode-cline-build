{
  "chat.disableAIFeatures": true,
  "chat.commandCenter.enabled": false,
  "chat.agent.enabled": false,
  "chat.panel.enabled": false,
  "chat.mcp.enabled": false,
  "chat.mcp.discovery.enabled": false,
  "chat.instructionsFilesLocations": [],
  "chat.editor.variableToolbar": false,
  "editor.inlineSuggest.enabled": false,
  "github.copilot.enable": {
    "*": false
  },
  "workbench.editor.empty.hint": false,
  "workbench.startupEditor": "none",
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.suggestSelection": "first",
  "editor.inlineHints.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 10000,
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "vs-seti",
  "workbench.tree.indent": 12,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/bun.lock": true
  },
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "cline.autoApprovalEnabled": true,
  "cline.allowedCommands": [
    "npm install",
    "npm run build",
    "npm run test",
    "npm run dev",
    "bun install",
    "bun run build",
    "bun run test",
    "bun run dev",
    "git status",
    "git diff",
    "git log",
    "git add",
    "git commit",
    "git push",
    "ls",
    "pwd",
    "cat",
    "mkdir",
    "touch",
    "rm"
  ],
  "cline.alwaysAllowReadOnly": true,
  "cline.alwaysAllowWrite": true,
  "cline.alwaysAllowExecute": true,
  "cline.alwaysAllowBrowser": true,
  "cline.alwaysAllowMcp": true
}
